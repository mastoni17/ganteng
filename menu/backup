# --- 1. CONFIGURATION & COLORS (PREMIUM PALETTE) ---
# Reset
NC='\033[0m'
# Regular Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
# Bold/Bright Colors (For Premium Look)
B_GREEN='\033[1;32m'
B_CYAN='\033[1;36m'
B_YELLOW='\033[1;33m'
B_WHITE='\033[1;37m'
B_MAGENTA='\033[1;35m'

# Backgrounds
BG_RED='\033[41m'
BG_GREEN='\033[42m'

# --- 2. PREMIUM ASSETS ---

# Function: Cool Progress Bar
# Penggunaan: jalankan_command & progress_bar $! "Pesan Text"
progress_bar() {
    local pid=$1
    local text=$2
    local delay=0.1
    local str="▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓"
    local empty="░░░░░░░░░░░░░░░░░░░░"
    local len=${#str}
    
    # Hide Cursor
    tput civis
    
    while kill -0 $pid 2>/dev/null; do
        for ((i=0; i<=len; i++)); do
            # Cek lagi apakah PID masih hidup di dalam loop
            if ! kill -0 $pid 2>/dev/null; then break; fi
            
            pct=$((i * 100 / len))
            left=${str:0:i}
            right=${empty:0:len-i}
            
            # Print Bar
            printf "\r   ${B_CYAN}⚡ %s : [${B_GREEN}%s${NC}${B_CYAN}%s${NC}] ${B_YELLOW}%3d%%${NC}" "$text" "$left" "$right" "$pct"
            sleep $delay
        done
        # Reverse animation effect (optional, or just loop)
        sleep 0.1
    done
    
    # Finish line
    printf "\r   ${B_CYAN}⚡ %s : [${B_GREEN}%s${NC}] ${B_GREEN}100%% ${NC} ✅ \n" "$text" "$str"
    # Restore Cursor
    tput cnorm
}

# Header Tampilan
clear
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_YELLOW}            🛡️  SYSTEM BACKUP PRO  🛡️            ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Date   : $(date +'%Y-%m-%d') ${NC}"
echo -e "${B_WHITE}  Time   : $(date +'%H:%M:%S') ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# --- 3. PREPARATION ---

# Getting bot info
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
export URL_DOC="https://api.telegram.org/bot$KEY/sendDocument"

IP=$(curl -sS ipv4.icanhazip.com)
domain=$(cat /etc/xray/domain)
date=$(date +"%Y-%m-%d")
timestamp=$(date +"%Y%m%d_%H%M%S")

echo ""

# --- 4. BACKUP PROCESS ---

BACKUP_DIR="/root/backup_${timestamp}"
BACKUP_FILE="/root/backup_${IP}_${timestamp}.zip"
BACKUP_FILE_NAME="backup_${IP}_${timestamp}.zip"

# A. Create Directory
mkdir -p "$BACKUP_DIR"
sleep 0.5

# B. Copy Files (Simulated process with bar)
(
    # System Configs
    cp /etc/passwd "$BACKUP_DIR/"
    cp /etc/group "$BACKUP_DIR/"
    cp /etc/shadow "$BACKUP_DIR/"
    cp /etc/gshadow "$BACKUP_DIR/"
    cp /etc/crontab "$BACKUP_DIR/" 2>/dev/null
    
    # Copy Directories
    # ---> CUSTOM: Menambahkan /usr/bin/kyt/ <---
    [ -d "/usr/bin/kyt/" ] && cp -r "/usr/bin/kyt/" "$BACKUP_DIR/"
    
    # Existing Directories
    [ -d "/var/lib/kyt/" ] && cp -r "/var/lib/kyt/" "$BACKUP_DIR/"
    [ -d "/etc/xray" ] && cp -r "/etc/xray" "$BACKUP_DIR/"
    [ -d "/var/www/html/" ] && cp -r "/var/www/html/" "$BACKUP_DIR/"
    
    sleep 2 # Memberi waktu agar bar terlihat keren
) & progress_bar $! "Collecting Data  "

# C. Zip Process
(
    cd "$BACKUP_DIR" || exit
    zip -r "$BACKUP_FILE" . > /dev/null 2>&1
    sleep 2
) & progress_bar $! "Compressing (ZIP)"

# D. Upload GDrive
(
    rclone copy "$BACKUP_FILE" dr:backup/ > /dev/null 2>&1
    sleep 2
) & progress_bar $! "Upload to GDrive "

# Get Link & Perbaikan Parsing URL Google Drive
url=$(rclone link dr:backup/"$BACKUP_FILE_NAME" 2>/dev/null)
if [[ "$url" =~ /file/d/([a-zA-Z0-9_-]+) ]]; then
    id="${BASH_REMATCH[1]}"
    link="https://drive.google.com/uc?id=${id}&export=download"
    tg_link="<a href='${link}'>🌐 Click Here to Download</a>"
elif [[ "$url" =~ "id=" ]]; then
    id=$(echo "$url" | grep -oP 'id=\K[^&]+')
    link="https://drive.google.com/uc?id=${id}&export=download"
    tg_link="<a href='${link}'>🌐 Click Here to Download</a>"
elif [[ -n "$url" ]]; then
    link="$url"
    tg_link="<a href='${link}'>🌐 Click Here to Download</a>"
else
    link="Unavailable / Rclone Error"
    tg_link="❌ Tautan Gagal Dibuat (Cek Konfigurasi Rclone)"
fi

# --- 5. NOTIFICATION (TELEGRAM ONLY) ---

# Send Telegram (Document + Caption Premium)
(
    # Format Caption Premium HTML
    CAPTION="
<b>☁️ CLOUD BACKUP NOTIFICATION</b>
━━━━━━━━━━━━━━━━━━━━━
<b>🆔 ID VPS :</b> <code>$IP</code>
<b>🗓 DATE   :</b> <code>$date</code>
<b>⏰ TIME   :</b> <code>$(date +"%H:%M:%S")</code>
━━━━━━━━━━━━━━━━━━━━━
<b>📂 FILE INFO</b>
<b>💾 Name :</b> <code>$BACKUP_FILE_NAME</code>
<b>🔗 G-Drive Link :</b>
$tg_link
━━━━━━━━━━━━━━━━━━━━━
<i>🤖 Automated by @HookageLegend</i>
"
    curl -s --max-time 60 -F chat_id="$CHATID" -F document=@"$BACKUP_FILE" -F caption="$CAPTION" -F parse_mode="HTML" "$URL_DOC" >/dev/null
) & progress_bar $! "Sending Telegram "

# Cleanup Temp Folder only
rm -rf "$BACKUP_DIR"

# --- 6. FINAL REPORT ---
echo ""
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_GREEN}            ✅ BACKUP COMPLETED SUCESSFULLY       ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${B_WHITE}📂 Local File :${NC} ${YELLOW}$BACKUP_FILE${NC}"
echo -e " ${B_WHITE}🔗 GDrive Link:${NC} ${B_CYAN}$link${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_MAGENTA}Note: File tersimpan di VPS & Telegram Bot.${NC}"
echo ""
read -n 1 -s -r -p "Press [ Enter ] to back menu"
echo ""