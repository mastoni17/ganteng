#!/bin/bash
# --- DEFINISI WARNA (FIXED: MENGGUNAKAN ANSI-C QUOTING) ---
RED=$'\e[1;31m'
GREEN=$'\e[1;32m'
YELLOW=$'\e[1;33m'
NC=$'\e[0m' # No Color

clear
echo -e "\033[1;93m┌──────────────────────────────────────────────┐\033[0m"
echo -e "        \033[42;37m    LIST MEMBER SHADOWSOCKS    \033[0m"
echo -e "\033[1;93m└──────────────────────────────────────────────┘\033[0m"

echo -e "Hostname/IP: $(curl -sS ipv4.icanhazip.com)"
echo -e "\033[1;93m──────────────────────────────────────────────\033[0m"
# Header Tabel
printf "%-15s | %-12s | %-10s\n" "Username" "Expired" "Status"
echo -e "\033[1;93m──────────────────────────────────────────────\033[0m"

DATABASE="/etc/shadowsocks/.shadowsocks.db"

if [[ -f "$DATABASE" ]]; then
    JUMLAH=$(grep -c -E "^### " "$DATABASE")
    
    # Loop membaca data
    grep -E "^### " "$DATABASE" | cut -d ' ' -f 2-3 | sort | uniq | while read -r user exp; do
        
        # 1. FIX TANGGAL KOSONG / HANYA SPASI
        exp_clean=$(echo "$exp" | tr -d '[:space:]')
        
        if [[ -z "$exp_clean" ]]; then
            exp="-"
            status="${RED}Invalid${NC}"
        else
            # Hitung Expired
            exp_date=$(date -d "$exp" +%s 2>/dev/null)
            now_date=$(date -d "$(date +%Y-%m-%d)" +%s)

            if [[ -z "$exp_date" ]]; then
                # Jika format tanggal salah (bukan angka/date valid)
                exp="-"
                status="${RED}Error${NC}"
            elif [[ $exp_date -ge $now_date ]]; then
                # Jika Aktif
                # Cek jika hari ini (Last Day)
                diff=$(( ($exp_date - $now_date) / 86400 ))
                if [[ "$diff" -eq 0 ]]; then
                    status="${YELLOW}Last Day${NC}"
                else
                    status="${GREEN}Active${NC}"
                fi
            else
                # Jika Expired
                status="${RED}Expired${NC}"
            fi
        fi

        # 2. FIX PRINTF (Gunakan %s karena variabel warna sudah di-encode)
        printf "%-15s | %-12s | %s\n" "$user" "$exp" "$status"
        
    done
else
    echo -e "${RED}Database tidak ditemukan.${NC}"
    JUMLAH=0
fi

echo -e "\033[1;93m──────────────────────────────────────────────\033[0m"
echo -e " Total Account: \033[1;36m$JUMLAH\033[0m Users"
echo -e "\033[1;93m└──────────────────────────────────────────────┘\033[0m"
echo -e ""
read -n 1 -s -r -p "Press any key to return..."
menu