#!/bin/bash
clear

# ==========================================
# MODERN COLOR PALETTE
# ==========================================
C_RESET="\e[0m"
C_GOLD="\e[1;33m"
C_CYAN="\e[1;36m"
C_WHITE="\e[1;37m"
C_GREEN="\e[1;32m"
C_RED="\e[1;31m"
C_PURPLE="\e[1;35m"

# ==========================================
# BOT & SYSTEM SETUP
# ==========================================
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3 2>/dev/null)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2 2>/dev/null)
export TIME="10"
export URL="https://api.telegram.org/bot$KEY/sendMessage"
MYIP=$(curl -sS ipv4.icanhazip.com 2>/dev/null)

# Mengambil nama user server
if [ -f /etc/xray/username ]; then
    nama=$(cat /etc/xray/username)
else
    nama="Premium User"
fi

# Mengambil IP/Domain dari ipvps.conf jika ada
source /var/lib/kyt/ipvps.conf 2>/dev/null
if [[ "$IP" = "" ]]; then
    domain=$(cat /etc/xray/domain 2>/dev/null)
else
    domain=$IP
fi

# ==========================================
# UI COMPONENTS
# ==========================================
function baris_panjang() {
  echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
}

function print_gradient() {
    if command -v lolcat &> /dev/null; then
        echo -e "$1" | lolcat
    else
        echo -e "${C_CYAN}$1${C_RESET}"
    fi
}

function xdxl_Banner() {
    clear
    print_gradient "════════════════════════════════════════════════"
    print_gradient "       ${C_GOLD}❖ CREATE TRIAL VMESS ACCOUNT ❖${C_RESET}   "
    print_gradient "      ════════════════════════════════"
    echo ""
}

function Sc_Credit() {
    sleep 1
    echo ""
    baris_panjang
    echo -e " ${C_GOLD}❖${C_RESET} ${C_WHITE}Terima kasih telah menggunakan layanan kami.${C_RESET}"
    echo -e " ${C_GOLD}❖${C_RESET} ${C_WHITE}Script Credit : ${C_GREEN}$nama${C_RESET}"
    baris_panjang
    echo ""
    read -rp " ⏎ Press [ENTER] to return to menu..."
    m-vmess
}

function Loading_Animasi() {
    echo ""
    echo -ne " ${C_CYAN}Processing Data${C_RESET} "
    for i in {1..20}; do
        echo -ne "${C_GOLD}█${C_RESET}"
        sleep 0.1
    done
    echo -e " ${C_GREEN}✔ DONE${C_RESET}"
    sleep 0.5
}

# ==========================================
# LICENSE CHECKING 
# ==========================================
data_server=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date_list=$(date +"%Y-%m-%d" -d "$data_server")
data_ip="https://raw.githubusercontent.com/mastoni17/ijin/refs/heads/main/regmas"

function checking_sc() {
  useexp=$(curl -sS $data_ip | grep $MYIP | awk '{print $3}')
  if [[ -z "$useexp" ]]; then
      return
  fi
  if [[ $date_list < $useexp ]]; then
    echo -ne
  else
    clear
    baris_panjang
    echo -e "          ${C_RED}404 NOT FOUND AUTOSCRIPT${C_RESET}          "
    baris_panjang
    echo -e ""
    echo -e "            ${C_RED}PERMISSION DENIED !${C_RESET}"
    echo -e "   ${C_GOLD}Your VPS${C_RESET} $MYIP ${C_GOLD}Has been Banned${C_RESET}"
    echo -e "     ${C_GOLD}Buy access permissions for scripts${C_RESET}"
    echo -e "             ${C_GOLD}Contact Admin :${C_RESET}"
    baris_panjang
    exit 0
  fi
}
checking_sc

# ==========================================
# CORE TRIAL GENERATION LOGIC
# ==========================================
xdxl_Banner

ISP=$(cat /root/.info/.isp 2>/dev/null || echo "Unknown ISP")
CITY=$(cat /root/.info/.city 2>/dev/null || echo "Unknown City")
masaaktif=1
Quota=0   # Unlimited
iplimit=0 # Unlimited Device

# Generate User Tanpa Backticks yang rawan error
rand_num=$(tr -dc 0-9 < /dev/urandom | head -c3)
user="Trial-VM${rand_num}"

echo -e " ${C_GOLD}➤ Detail Konfigurasi Trial :${C_RESET}"
echo -e "   ${C_CYAN}• User${C_RESET}  : ${C_WHITE}$user${C_RESET}"
echo -e "   ${C_CYAN}• Quota${C_RESET} : ${C_GREEN}Unlimited${C_RESET}"
echo -e "   ${C_CYAN}• Limit${C_RESET} : ${C_GREEN}Unlimited IP${C_RESET}"
echo ""

# --- FITUR BATAL DENGAN ENTER ---
echo -ne " ${C_GOLD}➤ Set Expired In Minutes (Enter kosong = Batal) : ${C_RESET}"
read -r pup

if [ -z "$pup" ]; then
    echo -e "\n ${C_RED}⚠ Input dibatalkan. Kembali ke menu...${C_RESET}"
    sleep 1
    m-vmess
    exit 0
fi

Loading_Animasi

# --- MEMPROSES DATA ---
uuid=$(cat /proc/sys/kernel/random/uuid)
exp=$(date -d "$masaaktif days" +"%Y-%m-%d")

# Injeksi config (Penulisan quote yang disederhanakan agar tidak error EOF)
sed -i '/#vmess$/a\### '"$user $exp"'\
},{"id": "'"${uuid}"'","alterId": 0,"email": "'"${user}"'"' /etc/xray/config.json

sed -i '/#vmessgrpc$/a\### '"$user $exp"'\
},{"id": "'"${uuid}"'","alterId": 0,"email": "'"${user}"'"' /etc/xray/config.json

sed -i '/#vmessup$/a\### '"$user $exp"'\
},{"id": "'"${uuid}"'","alterId": 0,"email": "'"${user}"'"' /etc/xray/config.json

# Pembuatan string JSON aman (Tanpa cat <<EOF multi-baris di dalam variabel)
asu='{"v":"2","ps":"'${user}'","add":"'${domain}'","port":"443","id":"'${uuid}'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'${domain}'","tls":"tls"}'
ask='{"v":"2","ps":"'${user}'","add":"'${domain}'","port":"80","id":"'${uuid}'","aid":"0","net":"ws","path":"/vmess","type":"none","host":"'${domain}'","tls":"none"}'
grpc='{"v":"2","ps":"'${user}'","add":"'${domain}'","port":"443","id":"'${uuid}'","aid":"0","net":"grpc","path":"vmess-grpc","type":"none","host":"'${domain}'","tls":"tls"}'
upg='{"v":"2","ps":"'${user}'","add":"'${domain}'","port":"443","id":"'${uuid}'","aid":"0","net":"httpupgrade","path":"/vmess-up","type":"none","host":"'${domain}'","tls":"tls"}'

vmesslink1="vmess://$(echo -n "$asu" | base64 -w 0)"
vmesslink2="vmess://$(echo -n "$ask" | base64 -w 0)"
vmesslink3="vmess://$(echo -n "$grpc" | base64 -w 0)"
vmesslink4="vmess://$(echo -n "$upg" | base64 -w 0)"

systemctl restart xray > /dev/null 2>&1
service cron restart > /dev/null 2>&1

# --- CREATE OPENCLASH FORMAT ---
cat >/var/www/html/vmess-$user.txt <<EOF

◇━━━━━━━━━━━━━━━━━◇
  Format For Clash
◇━━━━━━━━━━━━━━━━━◇

# Format Vmess WS TLS
- name: Vmess-$user-WS TLS
  type: vmess
  server: ${domain}
  port: 443
  uuid: ${uuid}
  alterId: 0
  cipher: auto
  udp: true
  tls: true
  skip-cert-verify: true
  servername: ${domain}
  network: ws
  ws-opts:
    path: /vmess
    headers:
      Host: ${domain}

# Format Vmess WS Non TLS
- name: Vmess-$user-WS Non TLS
  type: vmess
  server: ${domain}
  port: 80
  uuid: ${uuid}
  alterId: 0
  cipher: auto
  udp: true
  tls: false
  skip-cert-verify: false
  servername: ${domain}
  network: ws
  ws-opts:
    path: /vmess
    headers:
      Host: ${domain}

# Format Vmess gRPC
- name: Vmess-$user-gRPC (SNI)
  server: ${domain}
  port: 443
  type: vmess
  uuid: ${uuid}
  alterId: 0
  cipher: auto
  network: grpc
  tls: true
  servername: ${domain}
  skip-cert-verify: true
  grpc-opts:
    grpc-service-name: vmess-grpc

# Format Vmess HTTPUpgrade
- name: Vmess-$user-HTTPUpgrade
  type: vmess
  server: ${domain}
  port: 443
  uuid: ${uuid}
  alterId: 0
  cipher: auto
  udp: true
  tls: true
  skip-cert-verify: true
  servername: ${domain}
  network: httpupgrade
  httpupgrade-opts:
    path: /vmess-up
    headers:
      Host: ${domain}

EOF

# --- DATABASE & LIMIT CONFIGS ---
if [ ! -e /etc/vmess ]; then
  mkdir -p /etc/vmess
fi

if [[ $iplimit -gt 0 ]]; then
    mkdir -p /etc/kyt/limit/vmess/ip
    echo -e "$iplimit" > /etc/kyt/limit/vmess/ip/$user
fi

if [ -z ${Quota} ]; then
  Quota="0"
fi

c=$(echo "${Quota}" | sed 's/[^0-9]*//g')
d=$((${c} * 1024 * 1024 * 1024))

if [[ ${c} != "0" ]]; then
  echo "${d}" >/etc/vmess/${user}
fi

DATADB=$(cat /etc/vmess/.vmess.db 2>/dev/null | grep "^###" | grep -w "${user}" | awk '{print $2}')
if [[ "${DATADB}" != '' ]]; then
  sed -i "/\b${user}\b/d" /etc/vmess/.vmess.db
fi
echo "### ${user} ${exp} ${uuid} ${Quota} ${iplimit}" >>/etc/vmess/.vmess.db

# --- TELEGRAM BOT NOTIFICATION ---
TEXT="<code>◇━━━━━━━━━━━━━━━━━◇</code>
<code> XRAY/VMESS TRIAL</code>
<code>◇━━━━━━━━━━━━━━━━━◇</code>
<code>Remarks     : ${user}
Domain      : ${domain}
Limit Quota : Unlimited
Limit Ip    : Unlimited (Device)
Port TLS    : 400-900
Port NTLS   : 80, 8080, 8081-9999
id          : ${uuid}
alterId     : 0
Security    : auto
network     : ws, grpc, upgrade
Path WS     : /vmess
Path UPG    : /vmess-up
Name        : vmess-grpc</code>
<code>☉————————————————————————☉</code>
<code> VMESS WS TLS</code>
<code>☉————————————————————————☉</code>
<code>🧿</code><code>${vmesslink1}</code>
<code>☉————————————————————————☉</code>
<code> VMESS WS NO TLS</code>
<code>☉————————————————————————☉</code>
<code>🧿</code><code>${vmesslink2}</code>
<code>☉————————————————————————☉</code>
<code> VMESS gRPC</code>
<code>☉————————————————————————☉</code>
<code>🧿</code><code>${vmesslink3}</code>
<code>☉————————————————————————☉</code>
<code> VMESS HTTPUpgrade</code>
<code>☉————————————————————————☉</code>
<code>🧿</code><code>${vmesslink4}</code>
<code>☉————————————————————————☉</code>
Format OpenClash : https://${domain}:81/vmess-$user.txt
<code>☉————————————————————————☉</code>
Aktif Selama   : $pup Menit
<code>☉————————————————————————☉</code>"

curl -s --max-time "$TIME" -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" "$URL" >/dev/null

# --- JADWALKAN AUTO-DELETE ---
echo "tunnel vmess ${user}" | at now +$pup minutes &> /dev/null

# ==========================================
# DISPLAY TERMINAL OUTPUT (MODERN THEME)
# ==========================================
clear
xdxl_Banner
baris_panjang
echo -e "          ${C_GOLD}💎 VMESS TRIAL ACCOUNT CREATED 💎${C_RESET}"
baris_panjang
echo -e " ${C_CYAN}👤 Remarks${C_RESET}       : ${C_WHITE}${user}${C_RESET}"
echo -e " ${C_CYAN}🌐 Domain${C_RESET}        : ${C_WHITE}${domain}${C_RESET}"
echo -e " ${C_CYAN}📊 User Quota${C_RESET}    : ${C_GREEN}Unlimited${C_RESET}"
echo -e " ${C_CYAN}🖥️ Limit Ip${C_RESET}      : ${C_GREEN}Unlimited IP${C_RESET}"
echo -e " ${C_CYAN}🏢 ISP${C_RESET}           : ${C_WHITE}${ISP}${C_RESET}"
echo -e " ${C_CYAN}📍 Location${C_RESET}      : ${C_WHITE}${CITY}${C_RESET}"
echo -e " ${C_CYAN}🔐 Port TLS${C_RESET}      : ${C_WHITE}400-900${C_RESET}"
echo -e " ${C_CYAN}🔓 Port none TLS${C_RESET} : ${C_WHITE}80, 8080, 8880, 2082${C_RESET}"
echo -e " ${C_CYAN}🔑 Key / UUID${C_RESET}    : ${C_WHITE}${uuid}${C_RESET}"
echo -e " ${C_CYAN}⚙️ AlterId${C_RESET}       : ${C_WHITE}0${C_RESET}"
echo -e " ${C_CYAN}🛡️ Security${C_RESET}      : ${C_WHITE}auto${C_RESET}"
echo -e " ${C_CYAN}📡 Network${C_RESET}       : ${C_WHITE}ws, grpc, httpupgrade${C_RESET}"
echo -e " ${C_CYAN}🛤️ Path WS${C_RESET}       : ${C_WHITE}/vmess${C_RESET}"
echo -e " ${C_CYAN}🛤️ Path UPG${C_RESET}      : ${C_WHITE}/vmess-up${C_RESET}"
echo -e " ${C_CYAN}🚀 ServiceName${C_RESET}   : ${C_WHITE}vmess-grpc${C_RESET}"
baris_panjang
echo -e " ${C_GOLD}➤ Link TLS${C_RESET}       : ${C_WHITE}${vmesslink1}${C_RESET}"
baris_panjang
echo -e " ${C_GOLD}➤ Link WS${C_RESET}        : ${C_WHITE}${vmesslink2}${C_RESET}"
baris_panjang
echo -e " ${C_GOLD}➤ Link GRPC${C_RESET}      : ${C_WHITE}${vmesslink3}${C_RESET}"
baris_panjang
echo -e " ${C_GOLD}➤ Link Upgrade${C_RESET}   : ${C_WHITE}${vmesslink4}${C_RESET}"
baris_panjang
echo -e " ${C_GOLD}➤ OpenClash${C_RESET}      : ${C_WHITE}https://${domain}:81/vmess-$user.txt${C_RESET}"
baris_panjang
echo -e " ${C_RED}⏳ Aktif Selama${C_RESET}  : ${C_WHITE}$pup Menit${C_RESET}"
Sc_Credit