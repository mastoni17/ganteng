#!/bin/bash
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
B_GREEN='\033[1;32m'
B_CYAN='\033[1;36m'
B_YELLOW='\033[1;33m'
B_WHITE='\033[1;37m'
B_MAGENTA='\033[1;35m'
progress_bar() {
    local pid=$1
    local text=$2
    local delay=0.1
    local str="▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓"
    local empty="░░░░░░░░░░░░░░░░░░░░"
    local len=${#str}  
    tput civis
    while kill -0 $pid 2>/dev/null; do
        for ((i=0; i<=len; i++)); do
            if ! kill -0 $pid 2>/dev/null; then break; fi
            pct=$((i * 100 / len))
            left=${str:0:i}
            right=${empty:0:len-i}
            printf "\r   ${B_CYAN}⚡ %s : [${B_GREEN}%s${NC}${B_CYAN}%s${NC}] ${B_YELLOW}%3d%%${NC}" "$text" "$left" "$right" "$pct"
            sleep $delay
        done
        sleep 0.1
    done
    printf "\r   ${B_CYAN}⚡ %s : [${B_GREEN}%s${NC}] ${B_GREEN}100%% ${NC} ✅ \n" "$text" "$str"
    tput cnorm
}
clear
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_YELLOW}           ♻️  SYSTEM RESTORE PRO  ♻️           ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Memulihkan Data VPS dari File Backup (.zip)${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${B_MAGENTA}👉 Pilih Metode Input File:${NC}"
echo -e "   [1] Input Link Google Drive / Direct Link"
echo -e "   [2] Input Lokasi File Local (Contoh: /root/backup.zip)"
echo ""
read -p "   Pilih (1/2): " input_type

TEMP_DIR="/root/restore_temp"
BACKUP_FILE="/root/restore_data.zip"
mkdir -p "$TEMP_DIR"

if [[ "$input_type" == "1" ]]; then
    echo ""
    echo -e "${B_MAGENTA}👉 Paste Link Backup (Harus Direct/GDrive Link):${NC}"
    read -p "   Link: " url
    
    # Download Process
    echo ""
    (
        wget --no-check-certificate -q -O "$BACKUP_FILE" "$url"
        sleep 1
    ) & progress_bar $! "Downloading Data "
    
elif [[ "$input_type" == "2" ]]; then
    echo ""
    read -p "   Masukkan Path File: " local_path
    if [ -f "$local_path" ]; then
        cp "$local_path" "$BACKUP_FILE"
        echo -e "   ${GREEN}File ditemukan!${NC}"
    else
        echo -e "   ${RED}File tidak ditemukan!${NC}"
        exit 1
    fi
else
    echo -e "   ${RED}Pilihan tidak valid!${NC}"
    exit 1
fi
if ! unzip -t "$BACKUP_FILE" > /dev/null 2>&1; then
    echo -e "\n   ${RED}❌ ERROR: File bukan ZIP valid atau Corrupt.${NC}"
    rm -rf "$TEMP_DIR" "$BACKUP_FILE"
    exit 1
fi
(
    unzip -o "$BACKUP_FILE" -d "$TEMP_DIR" > /dev/null 2>&1
    sleep 2
) & progress_bar $! "Extracting Files "
(
    cd "$TEMP_DIR" || exit
    
    # 1. Restore System Configs
    [ -f passwd ] && cp -rf passwd /etc/passwd
    [ -f group ] && cp -rf group /etc/group
    [ -f shadow ] && cp -rf shadow /etc/shadow
    [ -f gshadow ] && cp -rf gshadow /etc/gshadow
    [ -f crontab ] && cp -rf crontab /etc/crontab
    if [ -d "xray" ]; then
        cp -rf xray /etc/
        chmod 755 /etc/xray
    fi
    if [ -d "html" ]; then
        mkdir -p /var/www/
        cp -rf html /var/www/
    fi
    if [ -d "kyt" ]; then
        mkdir -p /usr/bin/kyt
        cp -rf kyt/* /usr/bin/kyt/
        chmod +x /usr/bin/kyt/*
        mkdir -p /var/lib/kyt
        cp -rf kyt/* /var/lib/kyt/
    fi
    sleep 2
) & progress_bar $! "Restoring Configs"
(
    systemctl daemon-reload
    services=(nginx xray v2ray trojan ssh dropbear cron haproxy fail2ban stunnel4)
    for svc in "${services[@]}"; do
        if systemctl is-active --quiet "$svc" || systemctl is-enabled --quiet "$svc"; then
            systemctl restart "$svc" >/dev/null 2>&1
        fi
    done
    sleep 3
) & progress_bar $! "Restart Services "
rm -rf "$TEMP_DIR"
rm -f "$BACKUP_FILE"
echo ""
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_GREEN}           ✅ RESTORE COMPLETED SUCCESS          ${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_WHITE}  Semua file config, akun, dan folder kyt${NC}"
echo -e "${B_WHITE}  telah dikembalikan ke posisi semula.${NC}"
echo -e "${B_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${B_YELLOW}  Saran: Reboot VPS jika ada kendala koneksi.${NC}"
echo ""
read -n 1 -s -r -p "Press [ Enter ] to back menu"
echo ""