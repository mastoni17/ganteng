#!/bin/bash
# ======================================================
#   MASTONI GANTENG - MEMBER VMESS LIST (FIXED LAYOUT)
# ======================================================

# --- DEFINISI WARNA TEMA ---
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
BLINK='\033[5m'
BORDER="${CYAN}"

# --- CEK IZIN ---
ipsaya=$(curl -sS ipv4.icanhazip.com)
data_server=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date_list=$(date +"%Y-%m-%d" -d "$data_server")
data_ip="https://raw.githubusercontent.com/mastoni17/ijin/refs/heads/main/regmas"

checking_sc() {
  useexp=$(wget -qO- $data_ip | grep $ipsaya | awk '{print $3}')
  if [[ $date_list < $useexp ]]; then
    echo -ne
  else
    echo -e "${RED}PERMISSION DENIED !${NC}"
    exit 0
  fi
}
checking_sc
clear

# ==================================================
# FUNGSI GRADASI
# ==================================================
print_gradient() {
    local text="$1"
    awk -v text="$text" 'BEGIN {
        len = length(text);
        r_start=255; g_start=215; b_start=0;
        r_mid=0;      g_mid=128;   b_mid=255;
        r_end=138;    g_end=43;    b_end=226;
        for (i=0; i<len; i++) {
            ratio = i / (len-1);
            if (ratio <= 0.5) {
                f = ratio * 2;
                r = int(r_start + (r_mid - r_start) * f);
                g = int(g_start + (g_mid - g_start) * f);
                b = int(b_start + (b_mid - b_start) * f);
            } else {
                f = (ratio - 0.5) * 2;
                r = int(r_mid + (r_end - r_mid) * f);
                g = int(g_mid + (g_end - g_mid) * f);
                b = int(b_mid + (b_end - b_mid) * f);
            }
            printf "\033[38;2;%d;%d;%dm%s", r, g, b, substr(text, i+1, 1);
        }
        printf "\033[0m\n";
    }'
}

# FUNGSI BORDER
line() { echo -e "${BORDER} ╭───────────────────────────────────╮${NC}"; }
mid()  { echo -e "${BORDER} ├───────────────────────────────────┤${NC}"; }
close(){ echo -e "${BORDER} ╰───────────────────────────────────╯${NC}"; }

# ==================================================
# LOGIKA UTAMA
# ==================================================
echo -e ""
print_gradient "╭═══════════════════════════════════╮"
print_gradient "│      LIST USER VMESS DETAIL       │"
print_gradient "╰═══════════════════════════════════╯"
echo -e ""

# Ambil data user VMess
data=( `cat /etc/xray/config.json | grep '###' | cut -d ' ' -f 2 | sort | uniq`);
total_akun=${#data[@]}

if [[ $total_akun -eq 0 ]]; then
    line
    # Menggunakan echo biasa agar aman dari format error
    echo -e "${BORDER} │ ${RED}      TIDAK ADA USER VMESS        ${BORDER}│${NC}"
    close
else
    line
    # FIX: Menggunakan echo -e agar warna terbaca dengan benar (tidak bocor code)
    echo -e "${BORDER} │ ${WHITE}Total User: ${GREEN}${total_akun}${WHITE} Account             ${BORDER}│${NC}"
    mid
    
    num=1
    for user in "${data[@]}"
    do
        # Ambil Expired Date
        exp=$(grep -wE "^### $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq | head -1)
        
        # Ambil Created Date (Coba cari di log pembuatan jika ada)
        # Note: Jika "Unknown", berarti file log pembuatan user tidak ditemukan di sistem Anda.
        if [[ -e /etc/xray/vmess/$user ]]; then
            created=$(date -r "/etc/xray/vmess/$user" "+%Y-%m-%d")
        elif [[ -e /etc/limit/vmess/$user ]]; then
            created=$(date -r "/etc/limit/vmess/$user" "+%Y-%m-%d")
        else
            created="Unknown"
        fi

        # Hitung Sisa Hari
        if [[ $exp =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            d1=$(date -d "$exp" +%s)
            d2=$(date -d "$(date +%Y-%m-%d)" +%s)
            diff=$(( (d1 - d2) / 86400 ))
            
            if [[ "$diff" -lt 0 ]]; then
                status="${RED}${BLINK}Expired (${diff})${NC}"
            elif [[ "$diff" -eq 0 ]]; then
                status="${ORANGE}${BLINK}Expires Today${NC}"
            else
                status="${GREEN}${BLINK}${diff} Days Left${NC}"
            fi
        else
            exp="Unlimited"
            status="${GREEN}Lifetime${NC}"
        fi

        # --- TAMPILAN RAPI (TANPA GARIS KANAN DI BAGIAN ISI) ---
        # Ini mencegah tabel berantakan karena panjang user/warna berbeda
        
        echo -e "${BORDER} │ ${ORANGE}${num}. ${CYAN}${user}${NC}"
        echo -e "${BORDER} │    ${WHITE}Status  : ${status}"
        echo -e "${BORDER} │    ${WHITE}Created : ${PURPLE}${created}${NC}"
        echo -e "${BORDER} │    ${WHITE}Expired : ${RED}${exp}${NC}"
        
        # Garis pemisah antar user
        if [[ $num -lt $total_akun ]]; then
             echo -e "${BORDER} ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─ ─${NC}"
        fi
        
        ((num++))
    done
    close
fi

echo -e ""
read -n 1 -s -r -p " Press any key to back"
m-vmess