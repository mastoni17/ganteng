#!/bin/bash
NC='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
BOLD='\033[1m'
BORDER="${CYAN}"

ipsaya=$(curl -sS ipv4.icanhazip.com)
data_server=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date_list=$(date +"%Y-%m-%d" -d "$data_server")
data_ip="https://raw.githubusercontent.com/mastoni17/ijin/refs/heads/main/regmas"

checking_sc() {
  useexp=$(wget -qO- $data_ip | grep $ipsaya | awk '{print $3}')
  if [[ $date_list < $useexp ]]; then
    echo -ne
  else
    echo -e "\033[1;93m────────────────────────────────────────────\033[0m"
    echo -e "\033[42m          404 NOT FOUND AUTOSCRIPT          \033[0m"
    echo -e "\033[1;93m────────────────────────────────────────────\033[0m"
    echo -e ""
    echo -e "             ${RED}PERMISSION DENIED !${NC}"
    echo -e "   \033[0;33mYour VPS${NC} $ipsaya \033[0;33mHas been Banned${NC}"
    echo -e "     \033[0;33mBuy access permissions for scripts${NC}"
    echo -e "              \033[0;33mContact Admin :${NC}"
    echo -e "\033[1;93m────────────────────────────────────────────\033[0m"
    exit 0
  fi
}
checking_sc
clear
print_gradient() {
    local text="$1"
    awk -v text="$text" 'BEGIN {
        len = length(text);
        r_start=255; g_start=215; b_start=0;
        r_mid=0;      g_mid=128;   b_mid=255;
        r_end=138;    g_end=43;    b_end=226;
        for (i=0; i<len; i++) {
            ratio = i / (len-1);
            if (ratio <= 0.5) {
                f = ratio * 2;
                r = int(r_start + (r_mid - r_start) * f);
                g = int(g_start + (g_mid - g_start) * f);
                b = int(b_start + (b_mid - b_start) * f);
            } else {
                f = (ratio - 0.5) * 2;
                r = int(r_mid + (r_end - r_mid) * f);
                g = int(g_mid + (g_end - g_mid) * f);
                b = int(b_mid + (b_end - b_mid) * f);
            }
            printf "\033[38;2;%d;%d;%dm%s", r, g, b, substr(text, i+1, 1);
        }
        printf "\033[0m\n";
    }'
}
line() { echo -e "${BORDER} ╭───────────────────────────────────╮${NC}"; }
mid()  { echo -e "${BORDER} ├───────────────────────────────────┤${NC}"; }
close(){ echo -e "${BORDER} ╰───────────────────────────────────╯${NC}"; }
BACKUP_FILE="/etc/xray/trojan_backup"
restore_trojan() {
    clear
    print_gradient "╭═══════════════════════════════════╮"
    print_gradient "│      RESTORE DELETED TROJAN       │"
    print_gradient "╰═══════════════════════════════════╯"
    echo -e ""
    if [[ ! -f "$BACKUP_FILE" ]] || [[ ! -s "$BACKUP_FILE" ]]; then
        echo -e "${RED} No archived users found.${NC}"
        echo -e ""
        read -n 1 -s -r -p " Press any key to return"
        m-trojan
        return
    fi

    echo -e " List of archived users:"
    echo -e "${BORDER} ───────────────────────────────────${NC}"
    echo -e " No  |  Username  |  Password/Key"
    echo -e "${BORDER} ───────────────────────────────────${NC}"
    i=1
    while IFS=' ' read -r b_user b_pass; do
        printf " %-3s | %-10s | %s\n" "$i" "$b_user" "${b_pass:0:15}..."
        i=$((i+1))
    done < "$BACKUP_FILE"
    echo -e "${BORDER} ───────────────────────────────────${NC}"
    
    read -p " Select Number to Restore (x to cancel): " selection
    if [[ "$selection" == "x" ]]; then m-trojan; return; fi
    data_restore=$(sed -n "${selection}p" "$BACKUP_FILE")
    
    if [[ -z "$data_restore" ]]; then
        echo -e "${RED} Invalid selection.${NC}"
        sleep 1
        restore_trojan
        return
    fi
    user_res=$(echo "$data_restore" | awk '{print $1}')
    pass_res=$(echo "$data_restore" | awk '{print $2}')
    if grep -q "#! $user_res" /etc/xray/config.json; then
        echo -e "${RED} User $user_res already exists in active config!${NC}"
        sed -i "/^$user_res /d" "$BACKUP_FILE"
        read -n 1 -s -r -p " Press any key to return"
        m-trojan
        return
    fi

    echo -e ""
    echo -e " Restore User : ${GREEN}$user_res${NC}"
    echo -e " Original Pass: ${ORANGE}$pass_res${NC}"
    read -p " Active Duration (Days): " masaaktif
    exp=$(date -d "$masaaktif days" +"%Y-%m-%d")
    sed -i '/#trojan$/a\#! '"$user_res $exp"'\
},{"password": "'""$pass_res""'","email": "'""$user_res""'"' /etc/xray/config.json
    sed -i "/^$user_res /d" "$BACKUP_FILE"
    rm -f /etc/trojan/$user_res
    mkdir -p /etc/trojan
    echo -e "### $user_res $exp" >> /etc/trojan/.trojan.db

    systemctl restart xray
    echo -e ""
    echo -e "${GREEN} User $user_res successfully restored!${NC}"
    echo -e " Valid until: $exp"
    echo -e ""
    read -n 1 -s -r -p " Press any key to return"
    m-trojan
}
xp_trojan() {
    clear
    print_gradient "╭═══════════════════════════════════╮"
    print_gradient "│     AUTO DELETE EXPIRED TROJAN    │"
    print_gradient "╰═══════════════════════════════════╯"
    echo -e ""
    echo -e "\033[0;33m Checking Expired Trojan Users...\033[0m"
    
    if [[ ! -f "$BACKUP_FILE" ]]; then touch "$BACKUP_FILE"; fi
    data=( `cat /etc/xray/config.json | grep '^#!' | cut -d ' ' -f 2 | sort | uniq` )
    now=`date +"%Y-%m-%d"`
    found=0
    
    for user in "${data[@]}"
    do
        exp=$(grep -w "^#! $user" "/etc/xray/config.json" | cut -d ' ' -f 3 | sort | uniq)
        if [[ -z "$exp" ]]; then continue; fi

        d1=$(date -d "$exp" +%s)
        d2=$(date -d "$now" +%s)
        
        if [[ "$d1" -lt "$d2" ]]; then
            pass_tr=$(cat /etc/xray/config.json | grep -wE "^#! $user" -A 3 | grep "password" | awk -F '"' '{print $4}' | head -n 1)
            if [[ -n "$pass_tr" ]]; then
                if ! grep -q "^$user " "$BACKUP_FILE"; then
                    echo "$user $pass_tr" >> "$BACKUP_FILE"
                    echo -e "${CYAN} [ARCHIVE] User $user saved to recycle bin.${NC}"
                fi
            fi
            echo -e "${RED} [DEL] User $user Expired ($exp).${NC}"
            
            user_safe=$(echo "$user" | sed 's/\//\\\//g')
            sed -i "/^#! $user_safe $exp/,/^},{/d" /etc/xray/config.json
            sed -i "/^#! $user_safe $exp/,/^},{/d" /etc/xray/config.json
            
            rm -f /etc/mastoni/limit/trojan/ip/$user
            rm -f /etc/trojan/$user
            found=1
        fi
    done
    
    if [[ $found -eq 0 ]]; then
        echo -e "${GREEN} No expired users found.${NC}"
    else
        systemctl restart xray
        echo -e "${GREEN} Cleanup & Archiving Success.${NC}"
    fi
    echo -e ""
    read -n 1 -s -r -p " Press any key to return"
    m-trojan
}
echo -e ""
print_gradient "╭═══════════════════════════════════╮"
print_gradient "│       XRAY TROJAN MANAGEMENT      │"
print_gradient "╰═══════════════════════════════════╯"
echo -e ""

line
# Format printf
printf "${BORDER} │ ${ORANGE}1.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Create Account Trojan"
printf "${BORDER} │ ${ORANGE}2.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Create Trial Trojan"
mid
printf "${BORDER} │ ${ORANGE}3.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Renew Account Trojan"
printf "${BORDER} │ ${ORANGE}4.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Delete Account Trojan"
mid
printf "${BORDER} │ ${ORANGE}5.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Check Login Trojan"
printf "${BORDER} │ ${ORANGE}6.${NC} ${CYAN}%-31s ${BORDER}│${NC}\n" "Check Detail User"
mid
printf "${BORDER} │ ${ORANGE}7.${NC} ${RED}%-31s ${BORDER}│${NC}\n" "Auto Delete & Archive Exp"
printf "${BORDER} │ ${ORANGE}8.${NC} ${GREEN}%-31s ${BORDER}│${NC}\n" "Restore / Reactivate User"
mid
printf "${BORDER} │ ${ORANGE}x.${NC} ${ORANGE}%-31s ${BORDER}│${NC}\n" "Back To Main Menu"
close
echo -e ""
read -p " Select From Options [1-8 or x] : " menu

case $menu in
1) clear ; addtr ;;
2) clear ; trialtr ;;
3) clear ; renewtr ;;
4) clear ; deltr ;;
5) clear ; cektr ;;
6) clear ; cek-trojan ;;
7) xp_trojan ;;
8) restore_trojan ;;
x) menu ;;
*) m-trojan ;;
esac