#!/bin/bash
DIR="/var/www/html"
# --- COLOR DEFINITIONS ---
y='\033[1;33m' #yellow
CYAN="\033[96m"
z="\033[96m"
RED='\033[0;31m'
NC='\033[0m'
green='\033[0;32m'

# --- FUNGSI GRADASI FAST RENDER ---
print_gradient() {
    local text="$1"
    awk -v text="$text" 'BEGIN {
        len = length(text);
        r_start=255; g_start=215; b_start=0;
        r_mid=0;     g_mid=128;   b_mid=255;
        r_end=138;   g_end=43;    b_end=226;

        for (i=0; i<len; i++) {
            ratio = i / (len-1);
            if (ratio <= 0.5) {
                f = ratio * 2;
                r = int(r_start + (r_mid - r_start) * f);
                g = int(g_start + (g_mid - g_start) * f);
                b = int(b_start + (b_mid - b_start) * f);
            } else {
                f = (ratio - 0.5) * 2;
                r = int(r_mid + (r_end - r_mid) * f);
                g = int(g_mid + (g_end - g_mid) * f);
                b = int(b_mid + (b_end - b_mid) * f);
            }
            printf "\033[38;2;%d;%d;%dm%s", r, g, b, substr(text, i+1, 1);
        }
        printf "\033[0m\n";
    }'
}

# --- GLOBAL ARRAYS UNTUK PENOMORAN (DIKEMBALIKAN) ---
declare -a GLOBAL_USERS
declare -a GLOBAL_FILES
GLOBAL_IDX=1

# --- FUNGSI CEK EXPIRED DARI DALAM FILE ---
get_exp_status() {
    local file="$1"
    local raw_date=$(grep -iE "Berakhir|Expired|Exp|Kadaluarsa" "$file" | awk -F':' '{print $2}' | tr -d '\r' | tr -d ',' | sed 's/^[ \t]*//;s/[ \t]*$//' | head -n 1)
    
    if [[ -z "$raw_date" ]]; then
        raw_date=$(grep -oE "[0-9]{4}-[0-9]{2}-[0-9]{2}" "$file" | head -n 1)
    fi

    if [[ -z "$raw_date" ]]; then
        echo "None -1"
        return
    fi

    raw_date=$(echo "$raw_date" | sed 's/Mei/May/gi; s/Agt/Aug/gi; s/Okt/Oct/gi; s/Des/Dec/gi')

    local display_date=$(date -d "$raw_date" +"%Y-%m-%d" 2>/dev/null)
    local d1=$(date -d "$raw_date" +%s 2>/dev/null || echo 0)
    local d2=$(date +"%s")

    if [[ -z "$display_date" || "$d1" == "0" ]]; then
        echo "None -1"
        return
    fi

    if [[ "$d1" -ge "$d2" ]]; then
        echo "$display_date 1"
    else
        echo "$display_date 0"
    fi
}

# --- FUNGSI BACA DAN CETAK USER ---
baca_user() {
    local tipe=$(echo "$1" | tr '[:lower:]' '[:upper:]')
    local prefix=$1
    local START_IDX=$GLOBAL_IDX # Menggunakan nomor urut gabungan

    local users=()
    if ls "$DIR"/"$prefix"-*.txt 1> /dev/null 2>&1; then
        users=($(ls "$DIR"/"$prefix"-*.txt | awk -F/ '{print $NF}' | sed "s/^$prefix-//; s/.txt$//" | sort))
    fi
    local count=${#users[@]}

    echo -e " ${z}┌──────────────────────────────────────────────────────────┐${NC}"
    printf " ${z}│${NC} ${y}TOTAL DATA %-10s : %-31s${NC} ${z}│${NC}\n" "$tipe" "$count Account"
    echo -e " ${z}├──────────────────────────────────────────────────────────┤${NC}"

    if [[ $count -eq 0 ]]; then
        printf " ${z}│${NC}   ${RED}✖ %-52s${NC} ${z}│${NC}\n" "Belum ada user terdaftar"
    else
        local rows=10
        local cols=2
        local per_block=$((rows * cols))

        for (( b=0; b<count; b+=per_block )); do
            if [[ $b -gt 0 ]]; then
                printf " ${z}│${NC} %-56s ${z}│${NC}\n" ""
            fi

            for (( r=0; r<rows; r++ )); do
                local c1="" c2="" u1="" u2=""

                # Kolom 1
                local idx1=$(( b + 0*rows + r ))
                if [[ $idx1 -lt $count ]]; then
                    u1="${users[$idx1]}"
                    local id1=$(( START_IDX + idx1 ))
                    
                    local res1=$(get_exp_status "$DIR/${prefix}-${u1}.txt")
                    local exp_val1=$(echo "$res1" | awk '{print $1}')
                    local exp_sts1=$(echo "$res1" | awk '{print $2}')
                    
                    local c1_date=""
                    if [[ "$exp_sts1" == "1" ]]; then
                        c1_date="${green}$(printf "%-10s" "$exp_val1")${NC}"
                    elif [[ "$exp_sts1" == "0" ]]; then
                        c1_date="${RED}$(printf "%-10s" "$exp_val1")${NC}"
                    else
                        c1_date="${y}$(printf "%-10s" "No Date")${NC}"
                    fi
                    
                    local u1_pad=$(printf "%-11.11s" "$u1")
                    local id1_pad=$(printf "%3d" "$id1")
                    c1=" ${green}${id1_pad}.${NC} ${u1_pad} ${c1_date} "
                    
                    # Simpan data ke memori global
                    GLOBAL_USERS[$id1]="$u1"
                    GLOBAL_FILES[$id1]="$DIR/${prefix}-${u1}.txt"
                else
                    c1="                             " 
                fi

                # Kolom 2
                local idx2=$(( b + 1*rows + r ))
                if [[ $idx2 -lt $count ]]; then
                    u2="${users[$idx2]}"
                    local id2=$(( START_IDX + idx2 ))
                    
                    local res2=$(get_exp_status "$DIR/${prefix}-${u2}.txt")
                    local exp_val2=$(echo "$res2" | awk '{print $1}')
                    local exp_sts2=$(echo "$res2" | awk '{print $2}')
                    
                    local c2_date=""
                    if [[ "$exp_sts2" == "1" ]]; then
                        c2_date="${green}$(printf "%-10s" "$exp_val2")${NC}"
                    elif [[ "$exp_sts2" == "0" ]]; then
                        c2_date="${RED}$(printf "%-10s" "$exp_val2")${NC}"
                    else
                        c2_date="${y}$(printf "%-10s" "No Date")${NC}"
                    fi
                    
                    local u2_pad=$(printf "%-11.11s" "$u2")
                    local id2_pad=$(printf "%3d" "$id2")
                    c2=" ${green}${id2_pad}.${NC} ${u2_pad} ${c2_date} "
                    
                    # Simpan data ke memori global
                    GLOBAL_USERS[$id2]="$u2"
                    GLOBAL_FILES[$id2]="$DIR/${prefix}-${u2}.txt"
                else
                    c2="                             " 
                fi

                if [[ -z "$u1" && -z "$u2" ]]; then
                    break
                fi
                printf " ${z}│${NC}%b%b${z}│${NC}\n" "$c1" "$c2"
            done
        done
        # Update index agar tabel selanjutnya meneruskan nomor
        GLOBAL_IDX=$(( START_IDX + count ))
    fi
    echo -e " ${z}└──────────────────────────────────────────────────────────┘${NC}"
}

# --- MAIN LOOP (MENU INTERAKTIF) ---
while true; do
    clear
    GLOBAL_USERS=()
    GLOBAL_FILES=()
    GLOBAL_IDX=1

    echo -e " "
    print_gradient "╭═════════════════════════════════════════════╮"
    print_gradient "│          DATABASE PREMIUM USER              │"
    print_gradient "╰═════════════════════════════════════════════╯"
    echo -e ""

    baca_user "ssh"
    echo -e ""
    baca_user "vmess"
    echo -e ""
    baca_user "vless"
    echo -e ""
    baca_user "trojan"

    echo -e ""
    echo -e " ${z}══════════════════════════════════════════════════${NC}"
    echo -e " ${y}Ketik ${green}NOMOR${y} atau ${green}NAMA${y} untuk memilih (${RED}0${y} untuk keluar)${NC}"
    echo -e " ${y}Ketik ${RED}99${y} untuk ${RED}HAPUS SEMUA USER EXPIRED${NC}"
    echo -e " ${z}══════════════════════════════════════════════════${NC}"
    read -p " Masukkan Pilihan : " input_user

    if [[ -z "$input_user" ]]; then
        continue
    elif [[ "$input_user" == "0" ]]; then
        clear
        break
    elif [[ "$input_user" == "99" ]]; then
        # --- FITUR HAPUS SEMUA USER EXPIRED ---
        echo -e "\n ${y}Mencari dan menghapus akun yang sudah expired...${NC}"
        deleted_count=0
        
        for i in "${!GLOBAL_FILES[@]}"; do
            file_path="${GLOBAL_FILES[$i]}"
            if [[ -f "$file_path" ]]; then
                res=$(get_exp_status "$file_path")
                exp_sts=$(echo "$res" | awk '{print $2}')
                
                # Jika status expired (0)
                if [[ "$exp_sts" == "0" ]]; then
                    filename=$(basename "$file_path")
                    protokol="${filename%%-*}"
                    nama_akun="${filename#*-}"
                    nama_akun="${nama_akun%.txt}"
                    
                    echo -e " Menghapus: ${CYAN}$protokol${NC} - ${RED}$nama_akun${NC} ..."
                    
                    # 1. Hapus File Text Config
                    rm -f "$file_path"

                    # 2. Hapus dari Sistem / Xray sesuai protokol
                    case "$protokol" in
                        ssh)
                            userdel -f "$nama_akun" 2>/dev/null
                            ;;
                        vmess)
                            sed -i "/^### $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/vmess/.vmess.db 2>/dev/null
                            rm -f /etc/vmess/$nama_akun 2>/dev/null
                            ;;
                        vless)
                            sed -i "/^#& $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/vless/.vless.db 2>/dev/null
                            rm -f /etc/vless/$nama_akun 2>/dev/null
                            ;;
                        trojan)
                            sed -i "/^#! $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/trojan/.trojan.db 2>/dev/null
                            rm -f /etc/trojan/$nama_akun 2>/dev/null
                            ;;
                    esac
                    ((deleted_count++))
                fi
            fi
        done
        
        echo -e ""
        if [[ $deleted_count -gt 0 ]]; then
            # Restart service Xray satu kali saja setelah semua proses selesai
            systemctl restart xray 2>/dev/null
            echo -e " ${green}[ SUCCESS ]${NC} Berhasil menghapus ${deleted_count} user expired!"
        else
            echo -e " ${y}[ INFO ]${NC} Tidak ada user expired yang ditemukan."
        fi
        
        read -n 1 -s -r -p " Tekan tombol apa saja untuk kembali..."
        continue
    fi

    found=0
    file_path=""

    # 1. Pencarian berdasarkan Nomor urut
    if [[ -n "${GLOBAL_FILES[$input_user]}" ]]; then
        file_path="${GLOBAL_FILES[$input_user]}"
        found=1
    else
        # 2. Pencarian berdasarkan Nama
        for proto in ssh vmess vless trojan; do
            if [[ -f "$DIR/${proto}-${input_user}.txt" ]]; then
                file_path="$DIR/${proto}-${input_user}.txt"
                found=1
                break
            fi
        done
    fi

    # --- JIKA USER DITEMUKAN ---
    if [[ $found -eq 1 ]]; then
        # Ekstrak data dari nama file
        filename=$(basename "$file_path")
        protokol="${filename%%-*}"
        nama_akun="${filename#*-}"
        nama_akun="${nama_akun%.txt}"

        while true; do
            clear
            echo -e " "
            print_gradient "╭══════════════════════════════════════╮"
            print_gradient "│            DETAIL ACCOUNT            │"
            print_gradient "╰══════════════════════════════════════╯"
            echo -e ""
            
            # Tampilkan isi detail config
            cat "$file_path"
            
            echo -e ""
            echo -e " ${z}══════════════════════════════════════════════════════════${NC}"
            echo -e " ${y}Aksi untuk akun ${green}$nama_akun${y} (${CYAN}$protokol${y}) :${NC}"
            echo -e " ${RED}[1]${NC} Hapus Akun Ini"
            echo -e " ${green}[0]${NC} Kembali ke Database"
            echo -e " ${z}══════════════════════════════════════════════════════════${NC}"
            read -p " Pilih Aksi : " aksi_user

            if [[ "$aksi_user" == "1" ]]; then
                echo -e ""
                read -p " Yakin ingin menghapus permanen $nama_akun? (y/n): " confirm
                if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
                    echo -e "\n ${y}Sedang menghapus akun...${NC}"
                    
                    # 1. Hapus File Text Config di /var/www/html
                    rm -f "$file_path"

                    # 2. Hapus dari Sistem / Xray sesuai protokol
                    case "$protokol" in
                        ssh)
                            userdel -f "$nama_akun" 2>/dev/null
                            ;;
                        vmess)
                            sed -i "/^### $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/vmess/.vmess.db 2>/dev/null
                            rm -f /etc/vmess/$nama_akun 2>/dev/null
                            systemctl restart xray 2>/dev/null
                            ;;
                        vless)
                            sed -i "/^#& $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/vless/.vless.db 2>/dev/null
                            rm -f /etc/vless/$nama_akun 2>/dev/null
                            systemctl restart xray 2>/dev/null
                            ;;
                        trojan)
                            sed -i "/^#! $nama_akun /,/^},{/d" /etc/xray/config.json 2>/dev/null
                            sed -i "/\b$nama_akun\b/d" /etc/trojan/.trojan.db 2>/dev/null
                            rm -f /etc/trojan/$nama_akun 2>/dev/null
                            systemctl restart xray 2>/dev/null
                            ;;
                    esac

                    echo -e " ${green}[ SUCCESS ]${NC} Akun ${nama_akun} berhasil dihapus!"
                    sleep 2
                    break # Keluar dari loop aksi, kembali ke list
                fi
            elif [[ "$aksi_user" == "0" ]]; then
                break # Keluar dari loop aksi, kembali ke list
            else
                echo -e " ${RED}Input salah!${NC}"; sleep 1
            fi
        done
    else
        echo -e "\n ${RED}[ ERROR ]${NC} User / Nomor '${input_user}' tidak ditemukan!"
        read -n 1 -s -r -p " Tekan tombol apa saja untuk kembali..."
    fi
done