#!/bin/bash
RED=$'\e[1;31m'
GREEN=$'\e[1;32m'
LGREEN=$'\e[92;1m' 
YELLOW=$'\e[1;33m'
CYAN=$'\e[1;36m'
NC=$'\e[0m'   

# --- 2. HEADER & BANNER ---
clear
echo -e "${CYAN}┌──────────────────────────────────────────────┐${NC}"
echo -e "         ${GREEN}LIST MEMBER SLOWDNS / SSH${NC}           "
echo -e "${CYAN}└──────────────────────────────────────────────┘${NC}"

echo -e "Hostname/IP: $(curl -sS ipv4.icanhazip.com)"
echo -e "${CYAN}──────────────────────────────────────────────${NC}"
# Header Tabel
printf "%-15s | %-12s | %-15s\n" "Username" "Expired" "Status"
echo -e "${CYAN}──────────────────────────────────────────────${NC}"

# --- 3. LOGIC LOOP USER ---
data=( `awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd` )
jumlah=${#data[@]}

for user in "${data[@]}"
do
    # Cek Masa Aktif (Exp) dari Command 'chage'
    exp=$(chage -l $user | grep "Account expires" | awk -F": " '{print $2}')
    
    # A. Jika akun "Never" expire (Unlimited)
    if [[ $exp == "never" ]] || [[ -z $exp ]]; then
        printf "%-15s | %-12s | %s\n" "$user" "Never" "${GREEN}Unlimited${NC}"
    else
        # B. Format Tanggal
        # Ubah format "Feb 18, 2026" menjadi timestamp & YYYY-MM-DD
        exp_date=$(date -d "$exp" +%s 2>/dev/null)
        now_date=$(date -d "$(date +%Y-%m-%d)" +%s)
        exp_text=$(date -d "$exp" +"%Y-%m-%d" 2>/dev/null)

        # Validasi jika tanggal gagal diparsing
        if [[ -z "$exp_text" ]]; then
            exp_text="Unknown"
            status="${RED}Error${NC}"
        else
            # Hitung Sisa Hari
            diff=$(( ($exp_date - $now_date) / 86400 ))

            if [[ "$diff" -ge 0 ]]; then
                if [[ "$diff" -eq 0 ]]; then
                    status="${YELLOW}Last Day${NC}"
                else
                    # Menggunakan LGREEN sesuai request (Hijau Terang)
                    status="${LGREEN}${diff} Days${NC}"
                fi
            else
                status="${RED}Expired${NC}"
            fi
        fi
        
        # C. PRINT DATA (Gunakan %s karena warna sudah di-encode di atas)
        printf "%-15s | %-12s | %s\n" "$user" "$exp_text" "$status"
    fi
done

echo -e "${CYAN}──────────────────────────────────────────────${NC}"
echo -e " Total User: ${CYAN}$jumlah${NC}"
echo -e "${CYAN}──────────────────────────────────────────────${NC}"
echo ""
read -n 1 -s -r -p "Press any key to back..."
menu-slowdns