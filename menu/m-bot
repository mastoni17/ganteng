}

# ==================================================
# FUNGSI BARU: JADWAL BACKUP (DESIGN SESUAI PERMINTAAN)
# ==================================================
func_schedule_backup() {
    clear
    # Cek Status Cron
    if crontab -l 2>/dev/null | grep -q "$BACKUP_CMD"; then
        sts_backup="$STS_ON"
        # Ambil jadwal raw
        sch=$(crontab -l | grep "$BACKUP_CMD" | head -n 1 | awk '{print $2}')
        if [[ "$sch" == "*" ]]; then info_sch="Setiap 1 Jam"; 
        elif [[ "$sch" == "*/6" ]]; then info_sch="Setiap 6 Jam";
        elif [[ "$sch" == "*/12" ]]; then info_sch="Setiap 12 Jam";
        elif [[ "$sch" == "0" ]]; then info_sch="Harian (00:00)";
        else 
            # Cek jika custom jam
            sch_hour=$(crontab -l | grep "$BACKUP_CMD" | head -n 1 | awk '{print $2}')
            info_sch="Jam $sch_hour:00 (Harian)"
        fi
    else
        sts_backup="$STS_OFF"
        info_sch="-"
    fi

    echo -e ""
    print_gradient "╭═══════════════════════════════════════╮"
    print_gradient "│         AUTO BACKUP SCHEDULER         │"
    print_gradient "╰═══════════════════════════════════════╯"
    line
    printf "${BORDER} │ ${WHITE}Status Auto Backup : %-15b ${BORDER}      │${NC}\n" "$sts_backup"
    printf "${BORDER} │ ${WHITE}Jadwal Saat Ini    : ${YELLOW}%-21s ${BORDER}│${NC}\n" "$info_sch"
    mid
    printf "${BORDER} │ ${CYAN}[1] %-31s ${BORDER}│${NC}\n" "Backup Setiap 1 Jam"
    printf "${BORDER} │ ${CYAN}[2] %-31s ${BORDER}│${NC}\n" "Backup Setiap 6 Jam"
    printf "${BORDER} │ ${CYAN}[3] %-31s ${BORDER}│${NC}\n" "Backup Setiap 12 Jam"
    printf "${BORDER} │ ${CYAN}[4] %-31s ${BORDER}│${NC}\n" "Backup Harian (Jam 00:00)"
    printf "${BORDER} │ ${CYAN}[5] %-31s ${BORDER}│${NC}\n" "Atur Waktu Manual (Set Jam)"
    printf "${BORDER} │ ${CYAN}[6] %-31s ${BORDER}│${NC}\n" "Matikan Auto Backup (OFF)"
    echo -e "${BORDER} │                                     │${NC}"
    printf "${BORDER} │ ${RED}[0] Kembali ke Menu Utama              ${BORDER}│${NC}\n"
    close
    
    echo -ne "  ${WHITE}Select Option : ${NC}"
    read -r ab_opt
    
    # Fungsi update cron internal
    update_cron() {
        crontab -l 2>/dev/null | grep -v "$BACKUP_CMD" | crontab -
        if [[ "$1" != "off" ]]; then
            (crontab -l 2>/dev/null; echo "$1") | crontab -
        fi
    }

    case $ab_opt in
        1)
            cmd_1() { update_cron "0 * * * * $BACKUP_CMD"; }
            echo -e ""; fun_bar 'cmd_1'; func_schedule_backup ;;
        2)
            cmd_2() { update_cron "0 */6 * * * $BACKUP_CMD"; }
            echo -e ""; fun_bar 'cmd_2'; func_schedule_backup ;;
        3)
            cmd_3() { update_cron "0 */12 * * * $BACKUP_CMD"; }
            echo -e ""; fun_bar 'cmd_3'; func_schedule_backup ;;
        4)
            cmd_4() { update_cron "0 0 * * * $BACKUP_CMD"; }
            echo -e ""; fun_bar 'cmd_4'; func_schedule_backup ;;
        5)
            echo -e ""
            echo -e "  ${WHITE}Masukkan Jam Backup (Format 24 Jam, 0-23)${NC}"
            echo -e "  ${YELLOW}Contoh: 7 = Jam 7 Pagi, 23 = Jam 11 Malam${NC}"
            echo -e ""
            read -p "  Input Jam : " jam_input
            
            # Validasi Input Angka
            if [[ "$jam_input" =~ ^[0-9]+$ ]] && [ "$jam_input" -ge 0 ] && [ "$jam_input" -le 23 ]; then
                 cmd_5() { update_cron "0 $jam_input * * * $BACKUP_CMD"; }
                 echo -e ""; fun_bar 'cmd_5'; func_schedule_backup
            else
                 echo -e "  ${RED}Input tidak valid! Harap masukkan angka 0-23.${NC}"
                 sleep 2; func_schedule_backup
            fi
            ;;
        6)
            cmd_6() { update_cron "off"; }
            echo -e ""; fun_bar 'cmd_6'; func_schedule_backup ;;
        0) show_main_menu ;;
        *) func_schedule_backup ;;
    esac
}

# ==================================================
# SUB-MENU: BOT PANEL (FIXED)
# ==================================================
bot_panel_menu() {
    clear
    # Cek Status Service
    if systemctl is-active --quiet kyt; then 
        s_bot="$STS_ON"
    else 
        s_bot="$STS_OFF"
    fi

    echo -e ""
    print_gradient "╭═══════════════════════════════════════╮"
    print_gradient "│             MENU BOT PANEL            │"
    print_gradient "╰═══════════════════════════════════════╯"
    
    line
    # PERBAIKAN DI SINI: Menggunakan %b untuk variabel warna agar tidak bocor
    printf "${BORDER} │ ${WHITE}Status Bot Service : %-15b ${BORDER}            │${NC}\n" "$s_bot"
    mid
    printf "${BORDER} │ ${CYAN}[1] %-33s ${BORDER}│${NC}\n" "Installer Bot Panel (Add)"
    printf "${BORDER} │ ${CYAN}[2] %-33s ${BORDER}│${NC}\n" "Delete Bot Panel (Hapus)"
    printf "${BORDER} │ ${CYAN}[3] %-33s ${BORDER}│${NC}\n" "Stop Service Bot"
    printf "${BORDER} │ ${CYAN}[4] %-33s ${BORDER}│${NC}\n" "Restart Service Bot"
    printf "${BORDER} │ ${CYAN}[5] %-33s ${BORDER}│${NC}\n" "Menu Fitur Bot Telegram"
    echo -e "${BORDER} │                                     │${NC}"
    printf "${BORDER} │ ${RED}[0] %-33s ${BORDER}│${NC}\n" "Kembali ke Menu Utama"
    close
    
    echo -ne "  ${WHITE}Select Option : ${NC}"
    read -r opt
    case $opt in
        1) clear; echo -e "${GREEN}[INFO] Downloading...${NC}"; wget -q "${BOT_INSTALLER_URL}" -O bot.sh && chmod +x bot.sh && ./bot.sh ;;
        2) clear; if command -v hapus-bot &> /dev/null; then hapus-bot; else echo -e "${RED}Script hapus-bot not found.${NC}"; sleep 2; bot_panel_menu; fi ;;
        3) func_stop_bot ;;
        4) func_restart_bot ;;
        5) clear; if command -v menu-bot &> /dev/null; then menu-bot; else echo -e "${RED}Script menu-bot not found.${NC}"; sleep 2; bot_panel_menu; fi ;;
        0) show_main_menu ;;
        *) bot_panel_menu ;;
    esac
}

# ==================================================
# MAIN MENU DISPLAY
# ==================================================
show_main_menu() {
    clear
    # Get Data
    os_name=$(grep -w PRETTY_NAME /etc/os-release | head -n1 | sed 's/PRETTY_NAME//g' | sed 's/=//g' | sed 's/"//g')
    IPVPS=$(curl -s ipv4.icanhazip.com)
    tram=$(free -m | awk 'NR==2 {print $2}')
    uram=$(free -m | awk 'NR==2 {print $3}')
    ram_display="$uram MB / $tram MB"
    domain=$(cat /etc/xray/domain 2>/dev/null || echo "Domain Not Set")

    # Check Services
    # Gunakan if-else sederhana untuk memastikan variable terisi string warna yang benar
    if systemctl is-active --quiet xray; then s_xray="$STS_ON"; else s_xray="$STS_OFF"; fi
    if systemctl is-active --quiet nginx; then s_nginx="$STS_ON"; else s_nginx="$STS_OFF"; fi
    if systemctl is-active --quiet kyt; then s_bot="$STS_ON"; else s_bot="$STS_OFF"; fi
    
    ws_stat=$(systemctl status ws | grep Active | awk '{print $3}' | tr -d '()')
    if [[ $ws_stat == "running" ]]; then s_ws="$STS_ON"; else s_ws="$STS_OFF"; fi

    # 1. Header
    echo -e ""
    print_gradient "╭═══════════════════════════════════════╮"
    print_gradient "│    ALPHA SCRIPT TELEGRAM PREMIUM      │"
    print_gradient "╰═══════════════════════════════════════╯"

    # 2. Client & System Info
    line
    printf "${BORDER} │ ${WHITE}Client : ${GREEN}%-26s ${BORDER}│${NC}\n" "${CLIENT_NAME:-User}"
    printf "${BORDER} │ ${WHITE}Expiry : ${GREEN}%-26s ${BORDER}│${NC}\n" "${days_remaining} Days"
    mid
    printf "${BORDER} │ ${CYAN}🖥️ %-7s  : ${WHITE}%-22s ${BORDER}│${NC}\n" "OS" "$os_name"
    printf "${BORDER} │ ${CYAN}📡 %-7s : ${WHITE}%-22s ${BORDER}│${NC}\n" "IP" "$IPVPS"
    printf "${BORDER} │ ${CYAN}💾 %-7s : ${WHITE}%-22s ${BORDER}│${NC}\n" "RAM" "$ram_display"
    close

    # 3. Status Summary
    echo -e ""
    print_gradient " ╭──────────────────────╮"
    print_gradient " │    SERVICE STATUS    │"
    print_gradient " ╰──────────────────────╯"
    line
    # Menggunakan %b untuk variabel status agar warna render sempurna
    printf "${BORDER} │ ${CYAN}⚡ %-24s %b ${BORDER}  │${NC}\n" "Xray Core" "$s_xray"
    printf "${BORDER} │ ${CYAN}🌏 %-24s %b ${BORDER}  │${NC}\n" "Nginx Webserver" "$s_nginx"
    printf "${BORDER} │ ${CYAN}🕸️  %-24s %b ${BORDER}  │${NC}\n" "WebSocket" "$s_ws"
    printf "${BORDER} │ ${CYAN}🤖 %-24s %b ${BORDER}  │${NC}\n" "Bot Telegram" "$s_bot"
    close

    # 4. Menu Options
    echo -e ""
    print_gradient " ╭──────────────────────╮"
    print_gradient " │      MENU OPTIONS    │"
    print_gradient " ╰──────────────────────╯"
    line
    printf "${BORDER} │ ${CYAN}[1] %-31s ${BORDER}│${NC}\n" "Menu BOT Panel"
    printf "${BORDER} │ ${CYAN}[2] %-31s ${BORDER}│${NC}\n" "Menu BOT Notifikasi"
    printf "${BORDER} │ ${CYAN}[3] %-31s ${BORDER}│${NC}\n" "Menu BOT Backup (Manual)"
    printf "${BORDER} │ ${CYAN}[4] %-31s ${BORDER}│${NC}\n" "UPDATE BOT TELEGRAM"
    mid
    printf "${BORDER} │ ${CYAN}[5] %-31s ${BORDER}│${NC}\n" "Menu Jadwal Backup (Auto)"
    echo -e "${BORDER} │                                     │${NC}"
    printf "${BORDER} │ ${RED}[x] %-31s ${BORDER}│${NC}\n" "Exit Menu"
    close

    # 5. Footer
    echo -e ""
    line
    echo -e "${BORDER} │ ${WHITE}${BOLD}          CONTACT SUPPORT            ${BORDER}│${NC}"
    mid
    printf "${BORDER} │ ${GREEN}📞 Whatsapp :${WHITE} %-21s ${BORDER}│${NC}\n" "085325108022"
    close
    echo -ne "  ${WHITE}Select Option : ${NC}"
}

# ==================================================
# LOOP UTAMA
# ==================================================
while true; do
    show_main_menu
    read -r menu
    case $menu in
        1) checking_sc; bot_panel_menu ;;
        2) clear; checking_sc; bot ;;
        3) 
            clear; checking_sc
            echo -e "\n${YELLOW}Note: Harap Setup ID & Token sebelum backup!${NC}"
            sleep 2; mbot-backup
            ;;
        4)
            clear
            echo -e "${GREEN} [INFO] Mengunduh Script Update Terbaru dari GitHub...${NC}"
            
            # Hapus file lama jika ada untuk memastikan file benar-benar baru
            rm -f /root/update-bot
            
            # Download file update-bot langsung dari GitHub ke /usr/bin/
            wget -q -O /root/update-bot "https://raw.githubusercontent.com/mastoni17/ganteng/refs/heads/main/bot/update-bot"
            
            # Berikan izin eksekusi pada script yang baru diunduh
            chmod +x /root/update-bot
            
            # Jalankan script update-bot
            /root/update-bot
            ;;
        5) checking_sc; func_schedule_backup ;;
        x|X) echo -e "\n${RED}Bye...${NC}"; exit 0 ;;
        *) echo -e "\n${RED}Invalid Option!${NC}"; sleep 1 ;;
    esac
done