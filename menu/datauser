#!/bin/bash
clear

# ==========================================
# MODERN COLOR PALETTE
# ==========================================
C_RESET="\e[0m"
C_GOLD="\e[1;33m"
C_CYAN="\e[1;36m"
C_WHITE="\e[1;37m"
C_GREEN="\e[1;32m"
C_RED="\e[1;31m"
C_PURPLE="\e[1;35m"

# Mengambil nama user
if [ -f /etc/xray/username ]; then
    nama=$(cat /etc/xray/username)
else
    nama="Premium User"
fi

# ==========================================
# UI COMPONENTS
# ==========================================
function baris_panjang() {
  echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
}

# Fungsi Gradient Sederhana
function print_gradient() {
    if command -v lolcat &> /dev/null; then
        echo -e "$1" | lolcat
    else
        echo -e "${C_CYAN}$1${C_RESET}"
    fi
}

function xdxl_Banner() {
    clear
    print_gradient "════════════════════════════════════════════════"
    print_gradient "        ${C_GOLD}❖ DAFTAR MEMBER VMESS AKTIF ❖${C_RESET}   "
    print_gradient "      ════════════════════════════════"
    echo ""
}

function Sc_Credit() {
    sleep 1
    echo ""
    baris_panjang
    echo -e " ${C_GOLD}❖${C_RESET} ${C_WHITE}Terima kasih telah menggunakan layanan kami.${C_RESET}"
    echo -e " ${C_GOLD}❖${C_RESET} ${C_WHITE}Script Credit : ${C_GREEN}$nama${C_RESET}"
    baris_panjang
    echo ""
    read -rp " ⏎ Press [ENTER] to return to menu..."
    m-vmess
}

# Animasi Progress Bar Halus
function Loading_Animasi() {
    echo ""
    echo -ne " ${C_CYAN}Processing Data${C_RESET} "
    for i in {1..20}; do
        echo -ne "${C_GOLD}█${C_RESET}"
        sleep 0.1
    done
    echo -e " ${C_GREEN}✔ DONE${C_RESET}"
    sleep 0.5
}

function Loading_Succes() {
    clear
    xdxl_Banner
}

# ==========================================
# CORE FUNCTIONS & LOGIC
# ==========================================
function Daftar_Member_Vmess() {

    
    # Mengambil daftar member dan menyimpannya ke dalam array
    mapfile -t member_lines < <(grep -E "^### " "/etc/xray/config.json" | cut -d ' ' -f 2-3 | sort | uniq)
    now=$(date +%s)
    
    if [ ${#member_lines[@]} -eq 0 ]; then
        echo -e "   ${C_RED}Tidak ada member aktif saat ini.${C_RESET}"
    else
        # --- HEADER TABEL ---
		print_gradient "══════════════════════════════════════════════"
        printf "   ${C_PURPLE}%-4s %-15s %-12s %s${C_RESET}\n" "No" "Nama User" "Tanggal Exp" "Expired"
        print_gradient "══════════════════════════════════════════════"
        
        # Menampilkan daftar
        for i in "${!member_lines[@]}"; do
            usr_name=$(echo "${member_lines[$i]}" | cut -d ' ' -f 1)
            exp_date=$(echo "${member_lines[$i]}" | cut -d ' ' -f 2)
            
            # Kalkulasi sisa hari
            exp_sec=$(date -d "$exp_date" +%s 2>/dev/null)
            if [ -n "$exp_sec" ]; then
                diff=$((exp_sec - now))
                days=$((diff / 86400))
                
                if [ $days -lt 0 ]; then
                    sisa="${C_RED}(Expired)${C_RESET}"
                elif [ $days -eq 0 ] && [ $diff -gt 0 ]; then
                    sisa="${C_GOLD}(Hari ini)${C_RESET}"
                else
                    sisa="${C_GREEN}($days Hari)${C_RESET}"
                fi
            else
                sisa="${C_RED}(Error)${C_RESET}"
            fi

            # --- MENGGUNAKAN %b AGAR KODE WARNA TERBACA ---
            printf "   ${C_GOLD}[%02d]${C_RESET} ${C_WHITE}%-15s${C_RESET} ${C_CYAN}%-12s${C_RESET} %b\n" "$((i+1))" "$usr_name" "$exp_date" "$sisa"
        done
    fi
    echo ""
    baris_panjang
    echo ""
}

function Cek_Config_Vmess() {
    # --- MENAMBAHKAN KETERANGAN (Enter = Kembali) ---
    echo -ne " ${C_GOLD}➤ Input Nomor/Username (Enter = Kembali) : ${C_RESET}"
    read -r input_user

    # --- LOGIKA JIKA TEKAN ENTER ---
    # Jika input kosong (hanya tekan Enter), maka langsung kembali ke menu
    if [ -z "$input_user" ]; then
        echo ""
        m-vmess
        exit 0
    fi

    # Mengambil hanya username untuk dicocokkan dengan nomor urut
    mapfile -t user_only < <(grep -E "^### " "/etc/xray/config.json" | cut -d ' ' -f 2 | sort | uniq)

    # Logika deteksi: Apakah user memasukkan ANGKA atau HURUF?
    if [[ "$input_user" =~ ^[0-9]+$ ]]; then
        idx=$((input_user - 1))
        if [[ $idx -ge 0 && $idx -lt ${#user_only[@]} ]]; then
            user="${user_only[$idx]}"
        else
            user=""
        fi
    else
        user="$input_user"
    fi

    # Validasi apakah user ditemukan di config
    if [ -z "$user" ] || ! grep -q "^### $user " "/etc/xray/config.json"; then
        echo -e "\n ${C_RED}⚠ User Tidak Ditemukan!${C_RESET}"
        read -n 1 -s -r -p " Press any key to return..."
        m-vmess
        exit 1
    else
        CITY=$(cat /etc/xray/city)
        ISP=$(cat /etc/xray/isp)
        domain=$(cat /etc/xray/domain)
        iplimit=$(cat /etc/kyt/limit/vmess/ip/$user)
        Quota1=$(cat /etc/vmess/$user)
        Quota=$((Quota1 / 1024 / 1024 / 1024))
        uuid=$(grep -E "^},{" "/etc/xray/config.json" |  grep -i '"'"${user}"'"' | cut -d " " -f 2 | cut -d '"' -f 2 | uniq )
        exp=$(grep -E "^### " "/etc/xray/config.json" | grep -i ' '"${user}"' ' | cut -d ' ' -f 3 | uniq )
        
        # Hitung sisa hari untuk Detail Akun
        now=$(date +%s)
        exp_sec=$(date -d "$exp" +%s 2>/dev/null)
        if [ -n "$exp_sec" ]; then
            diff=$((exp_sec - now))
            sisa_hari=$((diff / 86400))
            if [ $sisa_hari -lt 0 ]; then
                status_exp="${C_RED}Expired${C_RESET}"
            elif [ $sisa_hari -eq 0 ] && [ $diff -gt 0 ]; then
                status_exp="${C_GOLD}Berakhir Hari Ini${C_RESET}"
            else
                status_exp="${C_GREEN}$sisa_hari Hari Lagi${C_RESET}"
            fi
        else
            status_exp="Unknown"
        fi

asu=`cat<<EOF
      {
      "v": "2",
      "ps": "${user}",
      "add": "${domain}",
      "port": "443",
      "id": "${uuid}",
      "aid": "0",
      "scy": "auto",
      "net": "ws",
      "path": "/vmess",
      "type": "none",
      "host": "${domain}",
      "tls": "tls"
}
EOF`

ask=`cat<<EOF
      {
      "v": "2",
      "ps": "${user}",
      "add": "${domain}",
      "port": "80",
      "id": "${uuid}",
      "aid": "0",
      "scy": "auto",
      "net": "ws",
      "path": "/vmess",
      "type": "none",
      "host": "${domain}",
      "tls": "none"
}
EOF`

grpc=`cat<<EOF
      {
      "v": "2",
      "ps": "${user}",
      "add": "${domain}",
      "port": "443",
      "id": "${uuid}",
      "aid": "0",
      "scy": "auto",
      "net": "grpc",
      "path": "vmess-grpc",
      "type": "none",
      "host": "${domain}",
      "tls": "tls"
}
EOF`

upg=`cat<<EOF
      {
      "v": "2",
      "ps": "${user}",
      "add": "${domain}",
      "port": "443",
      "id": "${uuid}",
      "aid": "0",
      "scy": "auto",
      "net": "httpupgrade",
      "path": "/vmess-up",
      "type": "none",
      "host": "${domain}",
      "tls": "tls"
}
EOF`

        # PERBAIKAN: Menggunakan echo -n agar base64 tidak korup
        vmesslink1="vmess://$(echo -n "$asu" | base64 -w 0)"
        vmesslink2="vmess://$(echo -n "$ask" | base64 -w 0)"
        vmesslink3="vmess://$(echo -n "$grpc" | base64 -w 0)"
        vmesslink4="vmess://$(echo -n "$upg" | base64 -w 0)"
    fi
}

function Details_Account() {
    baris_panjang
    echo -e "          ${C_GOLD}💎 VMESS XRAY ACCOUNT DETAILS 💎${C_RESET}"
    baris_panjang
    echo -e " ${C_CYAN}👤 Remarks${C_RESET}       : ${C_WHITE}${user}${C_RESET}"
    echo -e " ${C_CYAN}🌐 Domain${C_RESET}        : ${C_WHITE}${domain}${C_RESET}"
    echo -e " ${C_CYAN}📊 User Quota${C_RESET}    : ${C_WHITE}${Quota} GB${C_RESET}"
    echo -e " ${C_CYAN}🖥️ User Ip${C_RESET}       : ${C_WHITE}${iplimit} IP${C_RESET}"
    echo -e " ${C_CYAN}🔐 Port TLS${C_RESET}      : ${C_WHITE}400-900${C_RESET}"
    echo -e " ${C_CYAN}🔓 Port NTLS${C_RESET}     : ${C_WHITE}80, 8080, 8880, 2082${C_RESET}"
    echo -e " ${C_CYAN}🔑 Key / UUID${C_RESET}    : ${C_WHITE}${uuid}${C_RESET}"
    echo -e " ${C_CYAN}📍 Location${C_RESET}      : ${C_WHITE}${CITY}${C_RESET}"
    echo -e " ${C_CYAN}🏢 ISP${C_RESET}           : ${C_WHITE}${ISP}${C_RESET}"
    echo -e " ${C_CYAN}⚙️ AlterId${C_RESET}       : ${C_WHITE}0${C_RESET}"
    echo -e " ${C_CYAN}🛡️ Security${C_RESET}      : ${C_WHITE}auto${C_RESET}"
    echo -e " ${C_CYAN}📡 Network${C_RESET}       : ${C_WHITE}ws, grpc, httpupgrade${C_RESET}"
    echo -e " ${C_CYAN}🛤️ Path WS${C_RESET}       : ${C_WHITE}/vmess${C_RESET}"
    echo -e " ${C_CYAN}🛤️ Path UPG${C_RESET}      : ${C_WHITE}/vmess-up${C_RESET}"
    echo -e " ${C_CYAN}🚀 ServiceName${C_RESET}   : ${C_WHITE}vmess-grpc${C_RESET}"
}

function Link_Json() {
    baris_panjang
    echo -e " ${C_GOLD}➤ Link TLS${C_RESET}       : ${C_WHITE}${vmesslink1}${C_RESET}"
    baris_panjang
    echo -e " ${C_GOLD}➤ Link WS${C_RESET}        : ${C_WHITE}${vmesslink2}${C_RESET}"
    baris_panjang
    echo -e " ${C_GOLD}➤ Link GRPC${C_RESET}      : ${C_WHITE}${vmesslink3}${C_RESET}"
    baris_panjang
    echo -e " ${C_GOLD}➤ Link UPGRADE${C_RESET}   : ${C_WHITE}${vmesslink4}${C_RESET}"
    baris_panjang
    echo -e " ${C_GOLD}➤ OpenClash${C_RESET}      : ${C_WHITE}https://${domain}:81/vmess-$user.txt${C_RESET}"
    baris_panjang
}

function Details_Expiry() {
    echo -e " ${C_RED}⏳ Expiry Date${C_RESET}   : ${C_WHITE}$exp ${C_CYAN}(${status_exp})${C_RESET}"
    baris_panjang
}

# ==========================================
# EXECUTION FLOW
# ==========================================
xdxl_Banner
Daftar_Member_Vmess
Cek_Config_Vmess
clear
Loading_Animasi
Loading_Succes
Details_Account
Link_Json
Details_Expiry
Sc_Credit