            print_gradient "                 DAFTAR USERNAME CLIENT XRAY                  "
            echo -e "${Blue}══════════════════════════════════════════════════════════════${NC}"
            printf " ${purple}%-4s %-15s %-40s${NC}\n" "No" "Username" "UUID / Password"
            echo -e "${CYAN} ------------------------------------------------------------${NC}"
            
            no=1
            for line in "${user_uuid_list[@]}"; do
                usr=$(echo "$line" | awk '{print $1}')
                uid=$(echo "$line" | awk '{print $2}')
                printf " ${YELL}[%02d]${NC} ${white}%-15s${NC} ${CYAN}%-40s${NC}\n" "$no" "$usr" "$uid"
                ((no++))
            done
            echo -e "${Blue}══════════════════════════════════════════════════════════════${NC}"
            echo ""
            
            echo -e "${YELL}➤ Mengubah Username / Email Client${NC}"
            read -p " Masukkan Nomor / Username Lama : " input_lama
            if [[ -z "$input_lama" ]]; then perbaikan_xray; return; fi
            
            # Sistem Smart Input
            old_user=""
            if [[ "$input_lama" =~ ^[0-9]+$ ]]; then
                idx=$((input_lama - 1))
                if [[ $idx -ge 0 && $idx -lt ${#user_uuid_list[@]} ]]; then
                    old_user=$(echo "${user_uuid_list[$idx]}" | awk '{print $1}')
                fi
            else
                for line in "${user_uuid_list[@]}"; do
                    usr=$(echo "$line" | awk '{print $1}')
                    if [[ "$input_lama" == "$usr" ]]; then
                        old_user="$usr"
                        break
                    fi
                done
            fi
            
            if [[ -z "$old_user" ]]; then
                echo -e "${RED}Username '$input_lama' tidak ditemukan di config!${NC}"
                sleep 2
                perbaikan_xray
                return
            fi
            
            echo -e " ${green}Username Terpilih:${NC} $old_user"
            read -p " Masukkan Username Baru : " new_user
            if [[ -z "$new_user" ]]; then perbaikan_xray; return; fi
            
            # Ganti Nama di config.json dan DB dengan Word Boundary (\b) agar presisi
            sed -i "s/\b$old_user\b/$new_user/g" /etc/xray/config.json
            sed -i "s/\b$old_user\b/$new_user/g" /etc/vmess/.vmess.db 2>/dev/null
            sed -i "s/\b$old_user\b/$new_user/g" /etc/vless/.vless.db 2>/dev/null
            sed -i "s/\b$old_user\b/$new_user/g" /etc/trojan/.trojan.db 2>/dev/null
            sed -i "s/\b$old_user\b/$new_user/g" /etc/shadowsocks/.shadowsocks.db 2>/dev/null
            
            # Ganti nama pada folder limit IP
            for proto in vmess vless trojan shadowsocks; do
                if [ -f "/etc/kyt/limit/$proto/ip/$old_user" ]; then
                    mv "/etc/kyt/limit/$proto/ip/$old_user" "/etc/kyt/limit/$proto/ip/$new_user"
                fi
            done
            
            # Ganti nama pada folder Kuota
            for proto in vmess vless trojan shadowsocks; do
                if [ -f "/etc/$proto/$old_user" ]; then
                    mv "/etc/$proto/$old_user" "/etc/$proto/$new_user"
                fi
            done

            # Update link OpenClash (jika ada file HTML)
            if [ -f "/var/www/html/vmess-$old_user.txt" ]; then
                mv "/var/www/html/vmess-$old_user.txt" "/var/www/html/vmess-$new_user.txt"
                sed -i "s/\b$old_user\b/$new_user/g" "/var/www/html/vmess-$new_user.txt"
            fi
            
            # Restart Xray
            systemctl restart xray > /dev/null 2>&1
            echo -e "${green}Username berhasil diubah dari '$old_user' menjadi '$new_user'!${NC}"
            read -n 1 -s -r -p " Press any key to back..."
            perbaikan_xray
            ;;
        x)
            menu-x
            ;;
        *)
            echo -e "${RED}Pilihan salah!${NC}"
            sleep 1
            perbaikan_xray
            ;;
    esac
}

