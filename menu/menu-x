function perbaikan_xray() {
    clear
    echo -e "${Blue}══════════════════════════════════════════════════${NC}"
    print_gradient "             MENU PERBAIKAN XRAY CONFIG     "
    echo -e "${Blue}══════════════════════════════════════════════════${NC}"
    echo -e " [1]  Backup config.json"
    echo -e " [2]  Ubah UUID Client"
    echo -e " [3]  Ubah Username / Email Client"
    echo -e " [x]  Kembali ke Menu Utama"
    echo -e "${Blue}══════════════════════════════════════════════════${NC}"
    read -p " Pilih Opsi [1-3 atau x]: " xray_opt

    case $xray_opt in
        1)
            clear
            echo -e "${YELL}➤ Melakukan backup /etc/xray/config.json...${NC}"
            bckp_name="config.json.bak_$(date +%Y%m%d_%H%M%S)"
            cp /etc/xray/config.json /etc/xray/$bckp_name
            sleep 1
            echo -e "${green}Backup berhasil disimpan sebagai:${NC} /etc/xray/$bckp_name"
            read -n 1 -s -r -p " Press any key to back..."
            perbaikan_xray
            ;;
        2)
            clear
            # Mengekstrak daftar UUID dan Nama dari config.json
            mapfile -t user_uuid_list < <(grep '"email":' /etc/xray/config.json | sed -E 's/.*"(id|password)": "([^"]+)".*"email": "([^"]+)".*/\3 \2/' | sort | uniq)
            
            echo -e "${Blue}══════════════════════════════════════════════════════════════${NC}"
            print_gradient "                   DAFTAR UUID CLIENT XRAY                    "
            echo -e "${Blue}══════════════════════════════════════════════════════════════${NC}"
            printf " ${purple}%-4s %-15s %-40s${NC}\n" "No" "Username" "UUID / Password"
            echo -e "${CYAN} ------------------------------------------------------------${NC}"
            
            no=1
            for line in "${user_uuid_list[@]}"; do
                usr=$(echo "$line" | awk '{print $1}')
                uid=$(echo "$line" | awk '{print $2}')
                printf " ${YELL}[%02d]${NC} ${white}%-15s${NC} ${CYAN}%-40s${NC}\n" "$no" "$usr" "$uid"
                ((no++))
            done
            echo -e "${Blue}══════════════════════════════════════════════════════════════${NC}"
            echo ""
            
            echo -e "${YELL}➤ Mengubah UUID Client${NC}"
            read -p " Masukkan Nomor / Username / UUID Lama : " input_lama
            if [[ -z "$input_lama" ]]; then perbaikan_xray; return; fi
            
            # Sistem Smart Input
            old_uuid=""
            if [[ "$input_lama" =~ ^[0-9]+$ ]]; then
                idx=$((input_lama - 1))
                if [[ $idx -ge 0 && $idx -lt ${#user_uuid_list[@]} ]]; then
                    old_uuid=$(echo "${user_uuid_list[$idx]}" | awk '{print $2}')
                fi
            else
                for line in "${user_uuid_list[@]}"; do
                    usr=$(echo "$line" | awk '{print $1}')
                    uid=$(echo "$line" | awk '{print $2}')
                    if [[ "$input_lama" == "$usr" || "$input_lama" == "$uid" ]]; then
                        old_uuid="$uid"
                        break
                    fi
                done
            fi
            
            if [[ -z "$old_uuid" ]]; then
                echo -e " ${RED}[!] Data tidak ditemukan!${NC}"
                sleep 2
                perbaikan_xray
                return
            fi
            
            echo -e " ${green}UUID Terpilih:${NC} $old_uuid"
            read -p " Masukkan UUID Baru (Kosongkan untuk auto-generate) : " new_uuid
            
            if [[ -z "$new_uuid" ]]; then
                new_uuid=$(cat /proc/sys/kernel/random/uuid)
                echo -e " ${green}UUID Baru di-generate:${NC} $new_uuid"
            fi
            
            # Eksekusi penggantian UUID
