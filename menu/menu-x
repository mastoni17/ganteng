            sed -i "s/$old_uuid/$new_uuid/g" /etc/vmess/.vmess.db 2>/dev/null
            sed -i "s/$old_uuid/$new_uuid/g" /etc/vless/.vless.db 2>/dev/null
            sed -i "s/$old_uuid/$new_uuid/g" /etc/trojan/.trojan.db 2>/dev/null
            sed -i "s/$old_uuid/$new_uuid/g" /etc/shadowsocks/.shadowsocks.db 2>/dev/null
            
            # Restart Xray
            systemctl restart xray > /dev/null 2>&1
            echo -e "${green}UUID Berhasil Diubah! Service Xray telah direstart.${NC}"
            read -n 1 -s -r -p " Press any key to back..."
            perbaikan_xray
